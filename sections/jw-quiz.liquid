{% comment %} "Is it right for me?" Six honest questions. Shows one of three results. No data leaves the page. {% endcomment %}
<section class="jw-quiz" id="jw-top">
  <div class="jw-wrap jw-narrow">
    <p class="jw-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1 class="jw-h1">{{ section.settings.heading | escape }}</h1>
    <p class="jw-lead">{{ section.settings.intro | escape }}</p>
    <form class="jw-card jw-quiz__form" id="jw-quiz-form">
      {%- for block in section.blocks -%}
        <fieldset class="jw-quiz__q" {{ block.shopify_attributes }} data-kind="{{ block.settings.kind }}">
          <legend class="jw-h3">{{ forloop.index }}. {{ block.settings.question | escape }}</legend>
          <label class="jw-quiz__opt"><input type="radio" name="q{{ forloop.index }}" value="yes" required> <span>Yes</span></label>
          <label class="jw-quiz__opt"><input type="radio" name="q{{ forloop.index }}" value="no"> <span>No</span></label>
        </fieldset>
      {%- endfor -%}
      <button type="submit" class="jw-btn jw-btn--primary jw-btn--block">{{ section.settings.button | escape }}</button>
    </form>
    <div class="jw-card jw-quiz__result" id="jw-quiz-result" hidden aria-live="polite">
      <h2 class="jw-h2" id="jw-quiz-title"></h2>
      <p class="jw-body" id="jw-quiz-text"></p>
      <div id="jw-quiz-cta"></div>
    </div>
    <noscript><p class="jw-body">This check needs JavaScript. The short version: if you have diabetes, circulation problems, reduced skin sensation, an unhealed wound or a joint that is hot and swollen, talk to your GP before using any heat product. Otherwise, the 90-day trial is there to answer the question for you.</p></noscript>
  </div>
</section>
<script>
  (function () {
    var form = document.getElementById('jw-quiz-form'); if (!form) return;
    var out = document.getElementById('jw-quiz-result');
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var stop = false, fit = 0, total = 0;
      form.querySelectorAll('fieldset').forEach(function (fs) {
        var v = (fs.querySelector('input:checked') || {}).value;
        if (fs.dataset.kind === 'gp' && v === 'yes') stop = true;
        if (fs.dataset.kind === 'fit') { total++; if (v === 'yes') fit++; }
      });
      var t = document.getElementById('jw-quiz-title'), x = document.getElementById('jw-quiz-text'), c = document.getElementById('jw-quiz-cta');
      if (stop) {
        t.textContent = {{ section.settings.r_gp_title | json }};
        x.textContent = {{ section.settings.r_gp_text | json }};
        c.innerHTML = '';
      } else if (fit >= Math.ceil(total / 2)) {
        t.textContent = {{ section.settings.r_yes_title | json }};
        x.textContent = {{ section.settings.r_yes_text | json }};
        c.innerHTML = '<a class="jw-btn jw-btn--primary" href="{{ routes.root_url }}#jw-buy">{{ section.settings.r_yes_button | escape }}</a>';
      } else {
        t.textContent = {{ section.settings.r_maybe_title | json }};
        x.textContent = {{ section.settings.r_maybe_text | json }};
        c.innerHTML = '<a class="jw-btn jw-btn--primary" href="{{ routes.root_url }}#jw-buy">{{ section.settings.r_maybe_button | escape }}</a>';
      }
      out.hidden = false; out.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
</script>
{% schema %}
{
  "name": "JW Is it right for me",
  "tag": "section",
  "class": "jw-section-quiz",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line", "default": "Two minutes, six questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Is Jointwell right for me?" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Honest answers, honest result. Nothing you tick here is sent anywhere." },
    { "type": "text", "id": "button", "label": "Button", "default": "Show my result" },
    { "type": "text", "id": "r_gp_title", "label": "GP result: title", "default": "Talk to your GP first" },
    { "type": "textarea", "id": "r_gp_text", "label": "GP result: text", "default": "You ticked something that means heat is not a safe default for you without advice: diabetes, circulation problems, reduced feeling in the skin, an unhealed wound, or a joint that is hot and swollen. That is not us being cautious for the sake of it. Ask your GP or physio, and if they say warmth is fine, come back. The 90-day trial will still be here." },
    { "type": "text", "id": "r_yes_title", "label": "Good fit: title", "default": "It sounds like the morning half hour is for you" },
    { "type": "textarea", "id": "r_yes_text", "label": "Good fit: text", "default": "A joint that is stiffest first thing, a wheat bag that goes cold, and a chair you sit in anyway. That is the person the wrap was found for. Try it for 90 days on your worst joint. If it does not help, post it back and we pay the postage." },
    { "type": "text", "id": "r_yes_button", "label": "Good fit: button", "default": "Try it for 90 days" },
    { "type": "text", "id": "r_maybe_title", "label": "Unsure: title", "default": "Possibly, and the trial exists for exactly this" },
    { "type": "textarea", "id": "r_maybe_text", "label": "Unsure: text", "default": "Your answers do not shout yes. Nobody can promise what a wrap will do for your joint, and we will not. What we can promise is warmth at the level you choose, held for thirty minutes, and 90 days to find out with the return postage paid." },
    { "type": "text", "id": "r_maybe_button", "label": "Unsure: button", "default": "Find out for 90 days" }
  ],
  "blocks": [
    { "type": "q", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "select", "id": "kind", "label": "Kind", "options": [ { "value": "fit", "label": "Fit (yes counts towards a good fit)" }, { "value": "gp", "label": "GP (yes means talk to your GP)" } ], "default": "fit" }
    ] }
  ],
  "presets": [{ "name": "JW Is it right for me", "blocks": [
    { "type": "q", "settings": { "question": "Is your knee, shoulder or elbow stiffest first thing in the morning, or after sitting?", "kind": "fit" } },
    { "type": "q", "settings": { "question": "Have you tried a wheat bag or hot water bottle and found it goes cold before it has done any good?", "kind": "fit" } },
    { "type": "q", "settings": { "question": "Do you sit down with a cup of tea most mornings for half an hour anyway?", "kind": "fit" } },
    { "type": "q", "settings": { "question": "Is the joint hot, red or more swollen than usual right now?", "kind": "gp" } },
    { "type": "q", "settings": { "question": "Do you have diabetes, a circulation problem, or reduced feeling in your skin?", "kind": "gp" } },
    { "type": "q", "settings": { "question": "Is there an unhealed wound or a recent operation on that joint?", "kind": "gp" } }
  ] }]
}
{% endschema %}
