{% comment %} Expectation timeline. Phrased as usage and habit, never as medical outcome. {% endcomment %}
<section class="jw-timeline">
  <div class="jw-wrap jw-narrow">
    <h2 class="jw-h2">{{ section.settings.heading | escape }}</h2>
    <p class="jw-lead">{{ section.settings.intro | escape }}</p>
    <ol class="jw-timeline__list">
      {%- for block in section.blocks -%}
        <li class="jw-timeline__item" {{ block.shopify_attributes }}>
          <span class="jw-timeline__when">{{ block.settings.when | escape }}</span>
          <p class="jw-body">{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ol>
    {% render 'jw-cta-strip', link: section.settings.cta_link, label: section.settings.cta_label %}
  </div>
</section>

{% schema %}
{
  "name": "JW What to expect",
  "tag": "section",
  "class": "jw-section-timeline",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What to expect, and when" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Nobody can promise what a wrap will do for your joint. Here is what using it looks like, so you know what you are trying." },
    { "type": "text", "id": "cta_label", "label": "Button text", "default": "Start the 90 days" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "when", "label": "When", "default": "Day 1" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Warmth you set, not warmth you wait for. Most people go straight to level 3." }
      ]
    }
  ],
  "presets": [
    {
      "name": "JW What to expect",
      "blocks": [
        { "type": "step", "settings": { "when": "Day 1", "text": "Warmth you set, not warmth you wait for. Charge it, strap it on, pick a level. Most people go straight to level 3." } },
        { "type": "step", "settings": { "when": "Day 3", "text": "The morning half hour becomes a habit. Kettle on, wrap on. It switches itself off when the tea is finished." } },
        { "type": "step", "settings": { "when": "Week 2", "text": "This is when people tell us the first-thing-in-the-morning stiffness is easier to walk off. Your joint gets the deciding vote, not our copy." } },
        { "type": "step", "settings": { "when": "Week 4", "text": "A month in. You will know by now whether it has earned its place by the kettle." } },
        { "type": "step", "settings": { "when": "Month 3", "text": "Your 90 days are up. Keep it, or post it back and we pay the postage. The warranty runs for two years either way." } }
      ]
    }
  ]
}
{% endschema %}
