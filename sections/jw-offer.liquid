{% comment %}
  Jointwell buy box: tier picker (two wraps preselected) and the itemised offer stack.
  Adds to cart without JavaScript: radios named "id" inside a /cart/add form.
  If no product is chosen in the theme editor, the button links to the product page instead.
{% endcomment %}
{%- liquid
  assign product = section.settings.product
  assign has_product = false
  if product != blank and product.available
    assign has_product = true
  endif
  assign tier_blocks = section.blocks | where: 'type', 'tier'
  assign stack_blocks = section.blocks | where: 'type', 'line'
  assign preselect = section.settings.preselect | default: 2
  assign fallback_link = section.settings.fallback_link | default: '#jw-top'

  comment
    Count the tiers that will actually render, so the preselected one always exists.
  endcomment
  assign tier_count = 0
  for block in tier_blocks
    if has_product and block.settings.variant_id == blank
      assign v = product.variants[forloop.index0]
      if v
        assign tier_count = tier_count | plus: 1
      endif
    else
      assign tier_count = tier_count | plus: 1
    endif
  endfor
  if preselect > tier_count
    assign preselect = tier_count
  endif
-%}
<section class="jw-offer" id="jw-buy">
  <div class="jw-wrap">
    <h2 class="jw-h2">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.intro != blank -%}
      <p class="jw-lead jw-offer__intro">{{ section.settings.intro | escape }}</p>
    {%- endif -%}

    <div class="jw-offer__grid">
      <div class="jw-offer__tiers">
        {%- if has_product -%}
        <form action="{{ routes.cart_add_url }}" method="post" class="jw-tier-form">
        {%- endif -%}
          <fieldset class="jw-tiers">
            <legend class="jw-h3">{{ section.settings.tiers_title | escape }}</legend>
            {%- for block in tier_blocks -%}
              {%- liquid
                assign idx = forloop.index
                assign variant_id = block.settings.variant_id
                if has_product and variant_id == blank
                  assign v = product.variants[forloop.index0]
                  if v
                    assign variant_id = v.id
                  endif
                endif
                if has_product and variant_id == blank
                  continue
                endif
                assign checked = ''
                if idx == preselect
                  assign checked = 'checked'
                endif
              -%}
              <label class="jw-tier {% if block.settings.badge != blank %}jw-tier--badged{% endif %}" {{ block.shopify_attributes }}>
                {%- if has_product and variant_id != blank -%}
                  <input type="radio" name="id" value="{{ variant_id }}" {{ checked }}>
                {%- else -%}
                  <input type="radio" name="jw-tier" value="{{ idx }}" {{ checked }}>
                {%- endif -%}
                <span class="jw-tier__body">
                  {%- if block.settings.badge != blank -%}
                    <span class="jw-tier__badge">{{ block.settings.badge | escape }}</span>
                  {%- endif -%}
                  <span class="jw-tier__name">{{ block.settings.name | escape }}</span>
                  <span class="jw-tier__sub">{{ block.settings.sub | escape }}</span>
                  <span class="jw-tier__price">
                    {%- if block.settings.was != blank -%}<s class="jw-price__was">{{ block.settings.was | escape }}</s>{%- endif -%}
                    <span class="jw-price__now">{{ block.settings.price | escape }}</span>
                  </span>
                  {%- if block.settings.savings != blank -%}
                    <span class="jw-tier__savings">{{ block.settings.savings | escape }}</span>
                  {%- endif -%}
                </span>
              </label>
            {%- endfor -%}
          </fieldset>

          {%- if has_product -%}
            <button type="submit" class="jw-btn jw-btn--primary jw-btn--block">{{ section.settings.button_label | escape }}</button>
          {%- else -%}
            <a class="jw-btn jw-btn--primary jw-btn--block" href="{{ fallback_link }}">{{ section.settings.button_label | escape }}</a>
          {%- endif -%}
          <ul class="jw-trust jw-trust--center" role="list">
            <li>90-day trial, we pay return postage</li>
            <li>2-year UK warranty</li>
            <li>Free tracked delivery</li>
          </ul>
        {%- if has_product -%}
        </form>
        {%- endif -%}
      </div>

      <div class="jw-offer__stack jw-card">
        {%- if section.settings.show_box_image -%}
          <img class="jw-offer__box" src="{{ 'jw-box.jpg' | asset_url }}" width="503" height="497" loading="lazy" alt="What comes in the box: the wrap, the extension strap, the USB-C cable and the manual">
        {%- endif -%}
        <h3 class="jw-h3">{{ section.settings.stack_title | escape }}</h3>
        <table class="jw-stack">
          <caption class="visually-hidden">What is included and what each item is worth</caption>
          <thead>
            <tr><th scope="col">In the box</th><th scope="col">Worth</th><th scope="col">You pay</th></tr>
          </thead>
          <tbody>
            {%- for block in stack_blocks -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ block.settings.item | escape }}</th>
                <td>{{ block.settings.worth | escape }}</td>
                <td class="jw-stack__pay">{{ block.settings.pay | escape }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
          <tfoot>
            <tr>
              <th scope="row">{{ section.settings.total_label | escape }}</th>
              <td>{{ section.settings.total_worth | escape }}</td>
              <td class="jw-stack__pay">{{ section.settings.total_pay | escape }}</td>
            </tr>
          </tfoot>
        </table>
        {%- if section.settings.stack_note != blank -%}
          <p class="jw-caption">{{ section.settings.stack_note | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JW Buy box and stack",
  "tag": "section",
  "class": "jw-section-offer",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your wrap" },
    { "type": "text", "id": "intro", "label": "Intro line", "default": "One for each knee, or one for you and one for your sister. Every tier carries the same trial and warranty." },
    { "type": "product", "id": "product", "label": "Product", "info": "Choose the Jointwell product so the button adds to basket. Tiers match variants in order (1st tier = 1st variant) unless a variant ID is set on the tier." },
    { "type": "url", "id": "fallback_link", "label": "Link if no product is chosen" },
    { "type": "text", "id": "tiers_title", "label": "Tier picker title", "default": "How many?" },
    { "type": "range", "id": "preselect", "label": "Preselected tier", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Add to basket" },
    { "type": "header", "content": "Offer stack" },
    { "type": "checkbox", "id": "show_box_image", "label": "Show the photo of what is in the box", "default": true },
    { "type": "text", "id": "stack_title", "label": "Stack title", "default": "What you get for £49.96" },
    { "type": "text", "id": "total_label", "label": "Total row label", "default": "Total" },
    { "type": "text", "id": "total_worth", "label": "Total worth", "default": "£86.40" },
    { "type": "text", "id": "total_pay", "label": "Total you pay", "default": "£49.96" },
    { "type": "text", "id": "stack_note", "label": "Small note under the stack", "default": "Values are what each item costs bought separately. Nothing here is a limited-time trick." }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Two wraps" },
        { "type": "text", "id": "sub", "label": "Second line", "default": "One for each knee" },
        { "type": "text", "id": "price", "label": "Price", "default": "£71.96" },
        { "type": "text", "id": "was", "label": "Was price", "default": "£89.95" },
        { "type": "text", "id": "savings", "label": "Savings line", "default": "Save £27.96 against two at £49.96" },
        { "type": "text", "id": "badge", "label": "Badge (for example Most chosen)" },
        { "type": "text", "id": "variant_id", "label": "Variant ID (optional)", "info": "Leave blank to use the product's variants in order." }
      ]
    },
    {
      "type": "line",
      "name": "Stack line",
      "settings": [
        { "type": "text", "id": "item", "label": "Item", "default": "Extension strap (shoulder and elbow)" },
        { "type": "text", "id": "worth", "label": "Worth", "default": "£9" },
        { "type": "text", "id": "pay", "label": "You pay", "default": "Free" }
      ]
    }
  ],
  "presets": [
    {
      "name": "JW Buy box and stack",
      "blocks": [
        { "type": "tier", "settings": { "name": "One wrap", "sub": "Your worst joint", "price": "£49.96", "was": "£62.45", "savings": "", "badge": "" } },
        { "type": "tier", "settings": { "name": "Two wraps", "sub": "One for each knee", "price": "£71.96", "was": "£89.95", "savings": "Save £27.96 against two at £49.96", "badge": "Most chosen" } },
        { "type": "tier", "settings": { "name": "Four wraps", "sub": "One for you, one for your sister, two for the family", "price": "£99", "was": "£179.90", "savings": "Save £100.84 against four at £49.96", "badge": "Best value" } },
        { "type": "line", "settings": { "item": "Jointwell heated joint wrap", "worth": "£62.45", "pay": "£49.96" } },
        { "type": "line", "settings": { "item": "Extension strap (shoulder and elbow)", "worth": "£9", "pay": "Free" } },
        { "type": "line", "settings": { "item": "USB-C charging cable", "worth": "£6", "pay": "Free" } },
        { "type": "line", "settings": { "item": "Mugwort warming sachet", "worth": "£4", "pay": "Free" } },
        { "type": "line", "settings": { "item": "Tracked UK delivery", "worth": "£4.95", "pay": "Free" } },
        { "type": "line", "settings": { "item": "90-day trial, return postage paid", "worth": "", "pay": "Free" } },
        { "type": "line", "settings": { "item": "2-year warranty, UK support", "worth": "", "pay": "Included" } }
      ]
    }
  ]
}
{% endschema %}
