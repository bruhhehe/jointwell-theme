{% comment %}
  The mechanism: three big image rows, one idea each. Product photos if set, otherwise the built-in feature shots.
{% endcomment %}
{%- liquid
  assign product = section.settings.product
  if product == blank
    assign product = all_products[section.settings.product_handle]
  endif
-%}
<section class="jw4 jw4-mech" id="jw-how">
  <div class="jw-wrap">
    <div class="jw4__center">
      {%- if section.settings.eyebrow != blank -%}<p class="jw4__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="jw-h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.intro != blank -%}<p class="jw-lead">{{ section.settings.intro | escape }}</p>{%- endif -%}
    </div>
    {%- assign n = 0 -%}
    {%- for block in section.blocks -%}
      {%- assign n = n | plus: 1 -%}
      <div class="jw4-mech__row" {{ block.shopify_attributes }}>
        <div class="jw4-mech__media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200', sizes: '(min-width: 900px) 50vw, 100vw', class: 'jw4__img jw4-mech__img', alt: block.settings.title }}
          {%- elsif block.settings.product_image > 0 and product != blank and product.images.size >= block.settings.product_image -%}
            {%- assign idx = block.settings.product_image | minus: 1 -%}
            {{ product.images[idx] | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200', sizes: '(min-width: 900px) 50vw, 100vw', class: 'jw4__img jw4-mech__img', alt: block.settings.title }}
          {%- else -%}
            <img class="jw4__img jw4-mech__img" src="{{ block.settings.stock | asset_url }}" width="1024" height="1024" loading="lazy" alt="{{ block.settings.title | escape }}">
          {%- endif -%}
        </div>
        <div class="jw4-mech__copy">
          <span class="jw4-mech__num" aria-hidden="true">{{ n }}</span>
          <h3 class="jw-h3">{{ block.settings.title | escape }}</h3>
          <p class="jw-lead">{{ block.settings.text | escape }}</p>
        </div>
      </div>
    {%- endfor -%}
    {%- if section.settings.panel_text != blank -%}
      <figure class="jw4-mech__panel">
        {%- if section.settings.panel_image != blank -%}
          {{ section.settings.panel_image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'jw4__img', alt: section.settings.panel_text }}
        {%- elsif section.settings.panel_stock != blank -%}
          <img class="jw4__img" src="{{ section.settings.panel_stock | asset_url }}" width="1024" height="1024" loading="lazy" alt="{{ section.settings.panel_text | escape }}">
        {%- else -%}
          <div class="jw5-ph jw5-ph--wide" role="img" aria-label="Control panel"><span class="jw5-ph__icon" aria-hidden="true">&#128247;</span><span class="jw5-ph__text">The control panel, full width, with the four buttons labelled</span></div>
        {%- endif -%}
        <figcaption>{{ section.settings.panel_text | escape }}</figcaption>
      </figure>
    {%- endif -%}
    <p class="jw4-mech__only">{{ section.settings.only_line | escape }}</p>
    {% render 'jw-cta-strip', link: section.settings.cta_link, label: section.settings.cta_label %}
  </div>
</section>

{% schema %}
{
  "name": "JW4 Mechanism",
  "tag": "section",
  "class": "jw4-section-mech",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line",
      "default": "How it does that"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How it works"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Line under the heading",
      "default": "Held Heat. Warmth at the level you set, on the joint, for thirty minutes."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product (for its photos)"
    },
    {
      "type": "text",
      "id": "product_handle",
      "label": "Product handle (fallback)",
      "default": "jointwell-heated-joint-wrap"
    },
    {
      "type": "textarea",
      "id": "only_line",
      "label": "The one claim",
      "default": "Nothing else in the cupboard does all four: holds a level, strapped on, cordless, and switches itself off. That's the difference, and it is the only claim we make."
    },
    {
      "type": "textarea",
      "id": "panel_text",
      "label": "Line under the control panel photo",
      "default": "Four buttons and a number. Up, down, that's it. Susan, 69, set hers up on the first go. Her daughter checked afterwards."
    },
    {
      "type": "image_picker",
      "id": "panel_image",
      "label": "Control panel photo"
    },
    {
      "type": "select",
      "id": "panel_stock",
      "label": "Built-in control panel photo",
      "options": [
        {
          "value": "",
          "label": "None, show the brief"
        },
        {
          "value": "jw-review-brenda.jpg",
          "label": "Panel in hand, 45"
        },
        {
          "value": "jw-review-linda.jpg",
          "label": "Panel close up"
        },
        {
          "value": "jw-feature-heat.jpg",
          "label": "Heat levels tile"
        }
      ],
      "default": ""
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button",
      "default": "Try it for 90 days"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Warmth, held at the level you set"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "One sentence",
          "default": "Five levels from 45°C to 65°C. Pick one and it stays there for the whole half hour."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "range",
          "id": "product_image",
          "label": "Or product photo number (0 = use built-in)",
          "min": 0,
          "max": 9,
          "step": 1,
          "default": 0
        },
        {
          "type": "select",
          "id": "stock",
          "label": "Built-in photo",
          "options": [
            {
              "value": "jw-feature-heat.jpg",
              "label": "Five heat levels"
            },
            {
              "value": "jw-feature-massage.jpg",
              "label": "Three massage strengths"
            },
            {
              "value": "jw-feature-timer.jpg",
              "label": "Switches itself off"
            },
            {
              "value": "jw-feature-weight.jpg",
              "label": "360 g, cordless"
            },
            {
              "value": "jw-feature-joints.jpg",
              "label": "Knee, shoulder or elbow"
            },
            {
              "value": "jw-wrap-mug.jpg",
              "label": "Wrap and mug"
            },
            {
              "value": "jw-photo-kettle.jpg",
              "label": "At the kettle"
            },
            {
              "value": "jw-photo-armchair.jpg",
              "label": "Armchair with a book"
            },
            {
              "value": "jw-photo-garden-window.jpg",
              "label": "Garden window"
            },
            {
              "value": "jw-photo-radiator.jpg",
              "label": "Armchair by the radiator"
            }
          ],
          "default": "jw-feature-heat.jpg"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JW4 Mechanism",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Warmth, held at the level you set",
            "text": "Five levels from 45°C to 65°C. Pick one and it stays there for the whole half hour, instead of starting hot and fading like a wheat bag.",
            "stock": "jw-feature-heat.jpg"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Gentle massage, running alongside",
            "text": "Three strengths, or none. It runs at the same time as the warmth, so you are not holding anything or rubbing anything in.",
            "stock": "jw-feature-massage.jpg"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Strapped on, cordless, off by itself",
            "text": "It stays where you put it while you walk to the kettle. No wire. At 30 minutes it switches itself off, so it cannot be left running.",
            "stock": "jw-feature-timer.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
