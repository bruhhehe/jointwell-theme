{% comment %}
  The guarantee as a full-width dark band. Four terms, big. The only section that gets the dark colour.
{% endcomment %}
<section class="jw4 jw4--clay jw4-guar" id="jw-guarantee">
  <div class="jw-wrap jw4__center">
    {%- if section.settings.eyebrow != blank -%}<p class="jw4__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h2 class="jw-h2">{{ section.settings.heading | escape }}</h2>
    <p class="jw-lead">{{ section.settings.intro | escape }}</p>
    <ul class="jw4-guar__terms" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}><strong>{{ block.settings.big | escape }}</strong>{{ block.settings.text | escape }}</li>
      {%- endfor -%}
    </ul>
    {% render 'jw-cta-strip', link: section.settings.cta_link, label: section.settings.cta_label %}
  </div>
</section>

{% schema %}
{
  "name": "JW4 Guarantee band",
  "tag": "section",
  "class": "jw4-section-guar",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line",
      "default": "The 90-day worst-joint trial"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "If it does not help, we do not keep your money."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "One line under it",
      "default": "Use it for 90 days on your own knee, whenever it suits you. If you cannot feel the difference, post it back and we pay the return postage."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button",
      "default": "Start the 90 days"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "term",
      "name": "Term",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "big", "label": "Big", "default": "90 days" },
        { "type": "text", "id": "text", "label": "Small", "default": "to decide, from the day it arrives" }
      ]
    }
  ],
  "presets": [
    {
      "name": "JW4 Guarantee band",
      "blocks": [
        { "type": "term", "settings": { "big": "90 days", "text": "to decide, from the day it arrives" } },
        { "type": "term", "settings": { "big": "£0", "text": "to send it back. We pay the return postage" } },
        { "type": "term", "settings": { "big": "No reason", "text": "needed, though we would like to hear it" } },
        { "type": "term", "settings": { "big": "2 years", "text": "of warranty, replacement not repair, UK support" } }
      ]
    }
  ]
}
{% endschema %}
