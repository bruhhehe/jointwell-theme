{% comment %} Jointwell hero. Feeling first, product name last. {% endcomment %}
{%- liquid
  assign product = section.settings.product
  if product == blank and section.settings.product_handle != blank
    assign product = all_products[section.settings.product_handle]
  endif
  if product != blank
    assign price_text = product.price | money_without_trailing_zeros
    assign compare_text = ''
    if product.compare_at_price > product.price
      assign compare_text = product.compare_at_price | money_without_trailing_zeros
    endif
  else
    assign price_text = section.settings.price_text
    assign compare_text = section.settings.compare_text
  endif
  assign cta_link = section.settings.cta_link
-%}
<section class="jw-hero jw-hero--product" id="jw-top">
  <div class="jw-wrap jw-hero__grid">
    <div class="jw-hero__media jw-hero__media--product">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 48vw, 100vw', class: 'jw-hero__img', alt: section.settings.image_alt }}
      {%- elsif product != blank and product.images.size > 0 -%}
        {%- assign main_img = product.images[section.settings.main_index] | default: product.featured_image -%}
        {{ main_img | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 48vw, 100vw', class: 'jw-hero__img', alt: main_img.alt | default: section.settings.image_alt }}
      {%- else -%}
        <img class="jw-hero__img" src="{{ 'jw-hero.jpg' | asset_url }}" width="1024" height="1024" alt="{{ section.settings.image_alt | escape }}" fetchpriority="high">
      {%- endif -%}
      {%- if product != blank and product.images.size > 1 -%}
        <ul class="jw-hero__thumbs" role="list" data-jw-gallery>
          {%- for img in product.images limit: 4 -%}
            {%- if forloop.index0 == section.settings.main_index -%}{%- continue -%}{%- endif -%}
            <li><button type="button" class="jw-hero__thumbbtn" data-full="{{ img | image_url: width: 1400 }}" aria-label="Show photo {{ forloop.index }}">{{ img | image_url: width: 300 | image_tag: loading: 'lazy', class: 'jw-hero__thumb', alt: img.alt }}</button></li>
          {%- endfor -%}
          <li><button type="button" class="jw-hero__thumbbtn" data-full="{{ 'jw-in-the-box.jpg' | asset_url }}" aria-label="Show what comes in the box"><img class="jw-hero__thumb" src="{{ 'jw-in-the-box.jpg' | asset_url }}" width="300" height="300" loading="lazy" alt="What comes in the box: the wrap, the USB-C cable and the instructions"></button></li>
        </ul>
      {%- endif -%}
    </div>

    <div class="jw-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="jw-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="jw-h1">{{ section.settings.heading | escape }}</h1>
      <p class="jw-lead">{{ section.settings.subline | escape }}</p>

      <ul class="jw-hero__ticks" role="list">
        <li>{{ section.settings.tick_1 | escape }}</li>
        <li>{{ section.settings.tick_2 | escape }}</li>
        <li>{{ section.settings.tick_3 | escape }}</li>
      </ul>

      <a class="jw-hero__reviews" href="{{ section.settings.reviews_link | default: '#jw-reviews' }}">
        <span class="jw-stars" aria-hidden="true">★★★★★</span>
        <span>{{ section.settings.reviews_text | escape }}</span>
      </a>

      <p class="jw-hero__name">{{ section.settings.product_name | escape }}</p>
      <div class="jw-hero__pricerow">
        <div class="jw-hero__price" aria-label="Price">
          <s class="jw-price__was" data-jw-big-was{% if compare_text == blank %} hidden{% endif %}>{{ compare_text }}</s>
          <span class="jw-price__now" data-jw-big-price>{{ price_text }}</span>
          {%- if section.settings.price_note != blank -%}<span class="jw-price__note">{{ section.settings.price_note | escape }}</span>{%- endif -%}
        </div>
        {%- assign rq = section.settings.review_short | default: '' -%}
        {%- if rq != blank and section.settings.review_name != blank -%}
          <aside class="jw-card jw-review-card jw-hero__minicard" aria-label="Customer review">
            {%- if section.settings.review_photo != blank -%}
              {{ section.settings.review_photo | image_url: width: 120 | image_tag: loading: 'lazy', class: 'jw-review-card__photo', alt: section.settings.review_name }}
            {%- elsif section.settings.review_stock != blank -%}
              <img class="jw-review-card__photo" src="{{ section.settings.review_stock | asset_url }}" width="56" height="56" loading="lazy" alt="{{ section.settings.review_name | escape }}">
            {%- endif -%}
            <div>
              <p class="jw-review-card__name">{{ section.settings.review_name | escape }}{% if section.settings.review_age != blank %}, {{ section.settings.review_age | escape }}{% endif %}{% if section.settings.review_town != blank %}, {{ section.settings.review_town | escape }}{% endif %} <span class="jw-stars" aria-hidden="true">★★★★★</span></p>
              <blockquote class="jw-review-card__quote">{{ rq | escape }}</blockquote>
            </div>
          </aside>
        {%- endif -%}
      </div>

      {%- if product != blank and product.available -%}
        <form action="{{ routes.cart_add_url }}" method="post" class="jw-hero__tiers" id="jw-buy" data-jw-checkout>
          <input type="hidden" name="return_to" value="/checkout">
          <input type="hidden" name="quantity" value="1">
          <fieldset class="jw-hero__fieldset">
            <legend class="jw-hero__legend">{{ section.settings.tiers_legend | escape }}</legend>
            {%- for v in product.variants -%}
              {%- if v.available -%}
                {%- liquid
                  assign single = product.variants.first.price
                  assign units = 1
                  assign sub = section.settings.sub_1
                  assign badge = ''
                  if v.title contains 'Two'
                    assign units = 2
                    assign sub = section.settings.sub_2
                    assign badge = section.settings.badge_2
                  elsif v.title contains 'Four'
                    assign units = 4
                    assign sub = section.settings.sub_4
                    assign badge = section.settings.badge_4
                  endif
                  assign saving = single | times: units | minus: v.price
                -%}
                <label class="jw-tier2{% if badge != blank %} jw-tier2--badged{% endif %}">
                  <input type="radio" name="id" value="{{ v.id }}" data-price="{{ v.price | money_without_trailing_zeros }}" data-was="{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money_without_trailing_zeros }}{% endif %}" {% if forloop.index == section.settings.preselect %}checked{% endif %}>
                  <span class="jw-tier2__body">
                    {%- if badge != blank -%}<span class="jw-tier2__badge{% if units == 4 %} jw-tier2__badge--alt{% endif %}">{{ badge | escape }}</span>{%- endif -%}
                    <span class="jw-tier2__main">
                      <span class="jw-tier2__name">{{ v.title | escape }}</span>
                      <span class="jw-tier2__sub">{{ sub | escape }}{% if units > 1 %} <strong>Save {{ saving | money_without_trailing_zeros }} on {{ units }} singles.</strong>{% endif %}</span>
                    </span>
                    <span class="jw-tier2__price">
                      <span class="jw-price__now">{{ v.price | money_without_trailing_zeros }}</span>
                      {%- if v.compare_at_price > v.price -%}<s class="jw-price__was">{{ v.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}
                    </span>
                  </span>
                </label>
              {%- endif -%}
            {%- endfor -%}
          </fieldset>
          <button type="submit" class="jw-btn jw-btn--primary jw-btn--block jw-hero__btn"><span data-jw-label>{{ section.settings.cta_label | escape }}</span><span class="jw-hero__dot" aria-hidden="true">&ndash;</span><span data-jw-price>{{ product.selected_or_first_available_variant.price | money_without_trailing_zeros }}</span></button>
        </form>
      {%- else -%}
        <a class="jw-btn jw-btn--primary jw-btn--block jw-hero__btn" href="{{ cta_link | default: '#jw-buy' }}">{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}
      <ul class="jw-assure" role="list">
        <li><span class="jw-assure__icon" aria-hidden="true">&#128230;</span><span><strong>Free tracked delivery</strong><br>UK, every order</span></li>
        <li><span class="jw-assure__icon" aria-hidden="true">&#8634;</span><span><strong>90-day trial</strong><br>we pay return postage</span></li>
        <li><span class="jw-assure__icon" aria-hidden="true">&#10003;</span><span><strong>2-year warranty</strong><br>replacement, not repair</span></li>
        <li><span class="jw-assure__icon" aria-hidden="true">&#9993;</span><span><strong>UK support</strong><br>a reply within one working day</span></li>
      </ul>
      <p class="jw-caption jw-hero__note">{{ section.settings.disclaimer | escape }}</p>

      {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="jw-hero__payments" role="list" aria-label="Payment methods">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'jw-hero__payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.quiz_link != blank -%}
        <a class="jw-hero__quiz" href="{{ section.settings.quiz_link }}">{{ section.settings.quiz_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>
<script>
  (function () {
    var gal = document.querySelector('[data-jw-gallery]'), main = document.querySelector('.jw-hero__media--product .jw-hero__img');
    if (gal && main) {
      gal.querySelectorAll('.jw-hero__thumbbtn').forEach(function (b) {
        b.addEventListener('click', function () {
          main.removeAttribute('srcset'); main.removeAttribute('sizes'); main.src = b.getAttribute('data-full');
          gal.querySelectorAll('.jw-hero__thumbbtn').forEach(function (x) { x.classList.remove('is-active'); }); b.classList.add('is-active');
        });
      });
    }
    var form = document.querySelector('form.jw-hero__tiers[data-jw-checkout]');
    if (!form) return;
    var priceOut = form.querySelector('[data-jw-price]');
    var big = document.querySelector('[data-jw-big-price]');
    var bigWas = document.querySelector('[data-jw-big-was]');
    function sync() {
      var c = form.querySelector('input[name="id"]:checked');
      if (!c) return;
      var price = c.getAttribute('data-price') || '', was = c.getAttribute('data-was') || '';
      if (priceOut) priceOut.textContent = price;
      if (big) big.textContent = price;
      if (bigWas) { bigWas.textContent = was; bigWas.hidden = !was; }
    }
    form.querySelectorAll('input[name="id"]').forEach(function (r) {
      r.addEventListener('change', sync);
      r.addEventListener('click', sync);
    });
    form.addEventListener('change', sync);
    sync();
    form.addEventListener('submit', function (e) {
      var chosen = form.querySelector('input[name="id"]:checked');
      if (!chosen) return;
      e.preventDefault();
      window.location.href = '/cart/' + chosen.value + ':1';
    });
  })();
</script>

{% schema %}
{
  "name": "JW Hero",
  "tag": "section",
  "class": "jw-section-hero",
  "settings": [
    { "type": "header", "content": "Words" },
    { "type": "text", "id": "eyebrow", "label": "Small line above the headline", "default": "For knees, shoulders and elbows that have got worse over the years" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Get down on the floor with the grandchildren. And get back up again." },
    { "type": "textarea", "id": "subline", "label": "Sub-line", "default": "A cordless heated wrap with massage for knees, shoulders and elbows. Made for knees, shoulders and elbows that have got worse over the years. Try it for 90 days on your worst joint. If it does not help, we pay the postage back." },
    { "type": "text", "id": "product_name", "label": "Product name line", "default": "Jointwell heated joint wrap" },
    { "type": "range", "id": "main_index", "label": "Main photo: product photo number", "min": 0, "max": 9, "step": 1, "default": 1, "info": "0 is the studio shot. 1 is the wrap on a knee." },
    { "type": "textarea", "id": "disclaimer", "label": "One line near the buy box", "default": "A comfort device, not a medical treatment. If you have diabetes, circulation problems or reduced skin sensation, check with your GP before using heat." },
    { "type": "header", "content": "Tier picker" },
    { "type": "text", "id": "tiers_legend", "label": "Legend", "default": "How many?" },
    { "type": "range", "id": "preselect", "label": "Preselected tier", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "text", "id": "sub_1", "label": "One wrap: line under", "default": "For one knee, shoulder or elbow. Includes the extension strap." },
    { "type": "text", "id": "sub_2", "label": "Two wraps: line under", "default": "Both knees at once, or one for you and one for a partner." },
    { "type": "text", "id": "badge_2", "label": "Two wraps: badge", "default": "Most chosen" },
    { "type": "text", "id": "sub_4", "label": "Four wraps: line under", "default": "For the household." },
    { "type": "text", "id": "badge_4", "label": "Four wraps: badge", "default": "Best value" },
    { "type": "header", "content": "Review card beside the price" },
    { "type": "text", "id": "review_name", "label": "Name" },
    { "type": "text", "id": "review_age", "label": "Age" },
    { "type": "text", "id": "review_town", "label": "Town" },
    { "type": "text", "id": "review_short", "label": "One sentence, word for word from their review" },
    { "type": "image_picker", "id": "review_photo", "label": "Their photo" },
    { "type": "select", "id": "review_stock", "label": "Built-in customer photo", "options": [ { "value": "", "label": "None" }, { "value": "jw-review-sarah.jpg", "label": "Sarah" }, { "value": "jw-review-margaret.jpg", "label": "Margaret" }, { "value": "jw-review-linda.jpg", "label": "Linda" }, { "value": "jw-review-brenda.jpg", "label": "Brenda" }, { "value": "jw-review-susan.jpg", "label": "Susan" } ], "default": "" },
    { "type": "text", "id": "activity_line", "label": "Activity line", "info": "A true number, updated by hand, for example: 14 wraps posted this week. Leave blank to hide." },
    { "type": "header", "content": "Three ticks" },
    { "type": "text", "id": "tick_1", "label": "Tick 1", "default": "Heat held for a full 30 minutes, 45 to 65°C" },
    { "type": "text", "id": "tick_2", "label": "Tick 2", "default": "Three massage strengths, running alongside" },
    { "type": "text", "id": "tick_3", "label": "Tick 3", "default": "Switches itself off. Cordless, 360 g" },
    { "type": "header", "content": "Review line" },
    { "type": "text", "id": "reviews_text", "label": "Review count line", "default": "Customer reviews, with photos", "info": "Only write a number you can show on the page." },
    { "type": "url", "id": "reviews_link", "label": "Review link" },
    { "type": "header", "content": "Quiz link" },
    { "type": "text", "id": "quiz_label", "label": "Quiz link text", "default": "Is it right for me? Take the two-minute check" },
    { "type": "url", "id": "quiz_link", "label": "Quiz link" },
    { "type": "header", "content": "Price and button" },
    { "type": "product", "id": "product", "label": "Product", "info": "When set, the price comes from the product. Otherwise the text below is used." },
    { "type": "text", "id": "product_handle", "label": "Product handle (fallback)", "default": "jointwell-heated-joint-wrap" },
    { "type": "text", "id": "price_text", "label": "Price (fallback)", "default": "£49" },
    { "type": "text", "id": "compare_text", "label": "Was price (fallback)", "default": "£65" },
    { "type": "text", "id": "price_note", "label": "Price note", "default": "One payment. Free tracked UK delivery." },
    { "type": "text", "id": "cta_label", "label": "Button text", "default": "Try it for 90 days" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Leave blank to jump to the buy box below." },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Main photo (4:5)" },
    { "type": "text", "id": "image_alt", "label": "Photo description for screen readers", "default": "Woman at her kitchen table wearing the Jointwell wrap on her knee" }
  ],
  "presets": [{ "name": "JW Hero" }]
}
{% endschema %}
