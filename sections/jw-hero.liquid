{% comment %} Jointwell hero. Feeling first, product name last. {% endcomment %}
{%- liquid
  assign product = section.settings.product
  if product == blank and section.settings.product_handle != blank
    assign product = all_products[section.settings.product_handle]
  endif
  if product != blank
    assign price_text = product.price | money_without_trailing_zeros
    assign compare_text = ''
    if product.compare_at_price > product.price
      assign compare_text = product.compare_at_price | money_without_trailing_zeros
    endif
  else
    assign price_text = section.settings.price_text
    assign compare_text = section.settings.compare_text
  endif
  assign cta_link = section.settings.cta_link
-%}
<section class="jw-hero" id="jw-top">
  <div class="jw-wrap jw-hero__grid">
    <div class="jw-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="jw-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="jw-h1">{{ section.settings.heading | escape }}</h1>
      <p class="jw-lead">{{ section.settings.subline | escape }}</p>
      <p class="jw-hero__name">{{ section.settings.product_name | escape }}</p>

      <div class="jw-hero__price" aria-label="Price">
        {%- if compare_text != blank -%}
          <s class="jw-price__was">{{ compare_text }}</s>
        {%- endif -%}
        <span class="jw-price__now">{{ price_text }}</span>
        {%- if section.settings.price_note != blank -%}
          <span class="jw-price__note">{{ section.settings.price_note | escape }}</span>
        {%- endif -%}
      </div>

      {% render 'jw-cta-strip', link: cta_link, label: section.settings.cta_label %}
    </div>

    <div class="jw-hero__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', class: 'jw-hero__img', alt: section.settings.image_alt }}
      {%- else -%}
        <img class="jw-hero__img" src="{{ 'jw-hero.jpg' | asset_url }}" width="1024" height="1024" alt="{{ section.settings.image_alt | escape }}" fetchpriority="high">
      {%- endif -%}

      {%- assign rq = section.settings.review_short | default: '' -%}
      {%- if rq == blank -%}
        {%- assign rq = section.settings.review_quote | default: '' | split: '. ' | first -%}
      {%- endif -%}
      {%- if rq != blank and rq contains 'PLACEHOLDER' -%}{%- assign rq = '' -%}{%- endif -%}
      {%- if rq != blank -%}
      <aside class="jw-card jw-review-card jw-hero__review" aria-label="Customer review">
        <div class="jw-review-card__head">
          {%- if section.settings.review_photo != blank -%}
            {{ section.settings.review_photo | image_url: width: 160 | image_tag: loading: 'lazy', class: 'jw-review-card__photo', alt: section.settings.review_name }}
          {%- elsif section.settings.review_stock != blank -%}
            <img class="jw-review-card__photo" src="{{ section.settings.review_stock | asset_url }}" width="120" height="120" loading="lazy" alt="{{ section.settings.review_name | escape }}, photo supplied by customer">
          {%- endif -%}
          <div>
            <p class="jw-review-card__name">{{ section.settings.review_name | escape }}{% if section.settings.review_age != blank %}, {{ section.settings.review_age | escape }}{% endif %}{% if section.settings.review_town != blank %}, {{ section.settings.review_town | escape }}{% endif %}</p>
            <p class="jw-review-card__meta"><span class="jw-stars" aria-hidden="true">★★★★★</span> <span class="jw-verified">Verified buyer</span></p>
          </div>
        </div>
        <blockquote class="jw-review-card__quote">{{ rq | escape }}</blockquote>
        {%- if section.settings.review_link != blank -%}
          <a class="jw-review-card__link" href="{{ section.settings.review_link }}">Read the verified review</a>
        {%- endif -%}
      </aside>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JW Hero",
  "tag": "section",
  "class": "jw-section-hero",
  "settings": [
    { "type": "header", "content": "Words" },
    { "type": "text", "id": "eyebrow", "label": "Small line above the headline", "default": "For knees, shoulders and elbows that have got worse over the years" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Get down on the floor with the grandchildren. And get back up again." },
    { "type": "textarea", "id": "subline", "label": "Sub-line", "default": "A cordless heated wrap with massage for knees, shoulders and elbows. Made for knees, shoulders and elbows that have got worse over the years. Try it for 90 days on your worst joint. If it does not help, we pay the postage back." },
    { "type": "text", "id": "product_name", "label": "Product name line", "default": "Jointwell heated joint wrap" },
    { "type": "header", "content": "Price and button" },
    { "type": "product", "id": "product", "label": "Product", "info": "When set, the price comes from the product. Otherwise the text below is used." },
    { "type": "text", "id": "product_handle", "label": "Product handle (fallback)", "default": "jointwell-heated-joint-wrap" },
    { "type": "text", "id": "price_text", "label": "Price (fallback)", "default": "£49" },
    { "type": "text", "id": "compare_text", "label": "Was price (fallback)", "default": "£65" },
    { "type": "text", "id": "price_note", "label": "Price note", "default": "One payment. Free tracked UK delivery." },
    { "type": "text", "id": "cta_label", "label": "Button text", "default": "Try it for 90 days" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Leave blank to jump to the buy box below." },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Main photo (4:5)" },
    { "type": "text", "id": "image_alt", "label": "Photo description for screen readers", "default": "Woman at her kitchen table wearing the Jointwell wrap on her knee" },
    { "type": "header", "content": "Review card beside the price" },
    { "type": "paragraph", "content": "Use a real, verified review only. Link it to the Judge.me review so the tick can be checked." },
    { "type": "text", "id": "review_name", "label": "First name", "default": "Maggie" },
    { "type": "text", "id": "review_age", "label": "Age", "default": "64" },
    { "type": "text", "id": "review_town", "label": "Town" },
    { "type": "select", "id": "review_stock", "label": "Built-in customer photo", "options": [ { "value": "", "label": "None" }, { "value": "jw-review-sarah.jpg", "label": "Sarah" }, { "value": "jw-review-margaret.jpg", "label": "Margaret" }, { "value": "jw-review-linda.jpg", "label": "Linda" }, { "value": "jw-review-brenda.jpg", "label": "Brenda" }, { "value": "jw-review-susan.jpg", "label": "Susan" } ], "default": "" },
    { "type": "textarea", "id": "review_quote", "label": "Full quote", "info": "The customer's exact words. The card stays hidden until this is filled in." },
    { "type": "text", "id": "review_short", "label": "Short line for the card", "info": "One sentence, taken word for word from the full quote. Keeps the card small so it does not cover the photo. Leave blank to use the first sentence." },
    { "type": "image_picker", "id": "review_photo", "label": "Customer's own photo" },
    { "type": "url", "id": "review_link", "label": "Link to the Judge.me review" }
  ],
  "presets": [{ "name": "JW Hero" }]
}
{% endschema %}
