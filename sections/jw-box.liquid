{% comment %} What is in the box. A list, not a priced stack. {% endcomment %}
<section class="jw-boxsec jw-band">
  <div class="jw-wrap jw-boxsec__grid">
    <div>
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'jw-boxsec__img', alt: 'What comes in the box' }}
      {%- else -%}
        <img class="jw-boxsec__img" src="{{ 'jw-in-the-box.jpg' | asset_url }}" width="1200" height="1200" loading="lazy" alt="What comes in the box">
      {%- endif -%}
    </div>
    <div>
      <h2 class="jw-h2">{{ section.settings.heading | escape }}</h2>
      <p class="jw-lead">{{ section.settings.intro | escape }}</p>
      <ul class="jw-boxsec__list" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><strong>{{ block.settings.item | escape }}</strong>{% if block.settings.note != blank %} <span class="jw-muted">{{ block.settings.note | escape }}</span>{% endif %}</li>
        {%- endfor -%}
      </ul>
      {% render 'jw-cta-strip', label: section.settings.cta_label, style: 'card' %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "JW What's in the box",
  "tag": "section",
  "class": "jw-section-box",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's in the box" },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Everything you need, and nothing to buy afterwards." },
    { "type": "image_picker", "id": "image", "label": "Photo of the real box contents" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Try it for 90 days" }
  ],
  "blocks": [{ "type": "item", "name": "Item", "settings": [ { "type": "text", "id": "item", "label": "Item" }, { "type": "text", "id": "note", "label": "Note" } ] }],
  "presets": [{ "name": "JW What's in the box" }]
}
{% endschema %}
