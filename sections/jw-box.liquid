{% comment %} What is in the box. A list, not a priced stack. {% endcomment %}
<section class="jw-boxsec jw-band">
  <div class="jw-wrap jw-boxsec__grid">
    <div>
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'jw-boxsec__img', alt: 'What comes in the box' }}
      {%- else -%}
        <img class="jw-boxsec__img" src="{{ 'jw-in-the-box.jpg' | asset_url }}" width="1200" height="1200" loading="lazy" alt="What comes in the box">
      {%- endif -%}
    </div>
    <div>
      <h2 class="jw-h2">{{ section.settings.heading | escape }}</h2>
      <p class="jw-lead">{{ section.settings.intro | escape }}</p>
      {%- assign all_valued = true -%}{%- assign any_valued = false -%}
      {%- for block in section.blocks -%}{%- if block.type == 'item' -%}{%- if block.settings.value == blank -%}{%- assign all_valued = false -%}{%- else -%}{%- assign any_valued = true -%}{%- endif -%}{%- endif -%}{%- endfor -%}
      <ul class="jw-boxsec__list{% if any_valued %} jw-boxsec__list--valued{% endif %}" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type != 'item' -%}{%- continue -%}{%- endif -%}
          <li {{ block.shopify_attributes }}><span><strong>{{ block.settings.item | escape }}</strong>{% if block.settings.note != blank %} <span class="jw-muted">{{ block.settings.note | escape }}</span>{% endif %}</span>{% if block.settings.value != blank %}<span class="jw-boxsec__value">{{ block.settings.value | escape }}</span>{% endif %}</li>
        {%- endfor -%}
      </ul>
      {%- if all_valued and any_valued and section.settings.total_line != blank -%}
        <p class="jw-boxsec__total">{{ section.settings.total_line | escape }}</p>
      {%- endif -%}
      {%- assign has_spec = false -%}
      {%- for block in section.blocks -%}{%- if block.type == 'spec' and block.settings.value != blank -%}{%- assign has_spec = true -%}{%- endif -%}{%- endfor -%}
      {%- if has_spec -%}
        <details class="jw-boxsec__specs">
          <summary class="jw-boxsec__specsum">{{ section.settings.specs_label | escape }}</summary>
          <dl class="jw-specs__list">
            {%- for block in section.blocks -%}
              {%- if block.type != 'spec' or block.settings.value == blank -%}{%- continue -%}{%- endif -%}
              <div {{ block.shopify_attributes }}><dt>{{ block.settings.label | escape }}</dt><dd>{{ block.settings.value | escape }}</dd></div>
            {%- endfor -%}
          </dl>
        </details>
      {%- endif -%}
      {% render 'jw-cta-strip', label: section.settings.cta_label, style: 'card' %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "JW What's in the box",
  "tag": "section",
  "class": "jw-section-box",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's in the box" },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Everything you need, and nothing to buy afterwards." },
    { "type": "image_picker", "id": "image", "label": "Photo of the real box contents" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Try it for 90 days" },
    { "type": "text", "id": "total_line", "label": "Total line (shows only when every item has a value)", "default": "Bought separately that comes to well over £49. You pay £49, once.", "info": "Only use values you can evidence: a real price you or a comparable seller actually charge. The DMCC Act treats invented reference prices as misleading." },
    { "type": "text", "id": "specs_label", "label": "Specifics toggle label", "default": "The specifics, if you want them" }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [ { "type": "text", "id": "item", "label": "Item" }, { "type": "text", "id": "note", "label": "Note" }, { "type": "text", "id": "value", "label": "Value, for example £12 (optional, must be evidenced)" } ] },
    { "type": "spec", "name": "Specific", "settings": [ { "type": "text", "id": "label", "label": "Label" }, { "type": "text", "id": "value", "label": "Value" } ] }
  ],
  "presets": [{ "name": "JW What's in the box" }]
}
{% endschema %}
