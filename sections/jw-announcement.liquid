{% comment %} Jointwell announcement bar. Real offers only. Leave text blank to hide. {% endcomment %}
{%- if section.settings.text != blank -%}
<div class="jw-announce" role="region" aria-label="Announcement">
  <div class="jw-wrap">
    {%- if section.settings.link != blank -%}
      <a class="jw-announce__link" href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
    {%- else -%}
      <p class="jw-announce__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "JW Announcement bar",
  "tag": "section",
  "class": "jw-section-announce",
  "settings": [
    {
      "type": "paragraph",
      "content": "Only put a real, true offer here. No countdowns, no 'selling out'. If the launch price ends on a date, say the date."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Free tracked UK delivery on every order. 90-day trial, we pay the return postage."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    }
  ],
  "presets": [{ "name": "JW Announcement bar" }]
}
{% endschema %}
