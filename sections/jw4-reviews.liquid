{% comment %}
  Reviews wall. Real buyers only, their own photo, their own words. A card stays hidden until a quote is pasted.
{% endcomment %}
<section class="jw4 jw4-reviews" id="jw-reviews">
  <div class="jw-wrap">
    <div class="jw4__center">
      {%- if section.settings.eyebrow != blank -%}<p class="jw4__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="jw-h2">{{ section.settings.heading | escape }}</h2>
      <p class="jw-lead">{{ section.settings.intro | escape }}</p>
    </div>
    <ul class="jw4-reviews__grid" role="list">
      {%- for block in section.blocks -%}
        {%- if block.settings.quote == blank -%}{%- continue -%}{%- endif -%}
        <li class="jw4-reviews__card" {{ block.shopify_attributes }}>
          {%- if block.settings.photo != blank -%}
            {{ block.settings.photo | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 1000px) 33vw, (min-width: 750px) 50vw, 100vw', class: 'jw4-reviews__img', alt: block.settings.name }}
          {%- elsif block.settings.stock != blank -%}
            <img class="jw4-reviews__img" src="{{ block.settings.stock | asset_url }}" width="800" height="800" loading="lazy" alt="{{ block.settings.name | escape }}, photo they sent us">
          {%- endif -%}
          <div class="jw4-reviews__body">
            <div class="jw4-reviews__stars" aria-label="Five stars">★★★★★</div>
            <blockquote class="jw4-reviews__q">{{ block.settings.quote | escape }}</blockquote>
            <p class="jw4-reviews__who">{{ block.settings.name | escape }}{% if block.settings.age != blank %}, {{ block.settings.age | escape }}{% endif %}{% if block.settings.town != blank %}, {{ block.settings.town | escape }}{% endif %} <span>Verified buyer</span>{% if block.settings.uses != blank %} <span>{{ block.settings.uses | escape }}</span>{% endif %}</p>
            {%- if block.settings.link != blank -%}<p class="jw-caption"><a href="{{ block.settings.link }}">Read the verified review</a></p>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.note != blank -%}<p class="jw4-reviews__note">{{ section.settings.note | escape }}</p>{%- endif -%}
    {% render 'jw-cta-strip', link: section.settings.cta_link, label: section.settings.cta_label %}
  </div>
</section>

{% schema %}
{
  "name": "JW4 Reviews wall",
  "tag": "section",
  "class": "jw4-section-reviews",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line",
      "default": "Real orders, real photos"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customers, in their own words."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "One line under it",
      "default": "Every one has an order on file and sent us the photo themselves. We do not edit them, and the one who says the strap takes a minute to get right is here too."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Small note under the wall",
      "default": "Reviews are collected by Judge.me from real orders. We never pay for reviews and we never remove a low one."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button",
      "default": "Try it for 90 days"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "name", "label": "First name" },
        { "type": "text", "id": "age", "label": "Age" },
        { "type": "text", "id": "town", "label": "Town" },
        { "type": "text", "id": "uses", "label": "Uses it on" },
        { "type": "textarea", "id": "quote", "label": "Quote, word for word", "info": "The card stays hidden until a real quote is here." },
        { "type": "image_picker", "id": "photo", "label": "Their photo" },
        {
          "type": "select",
          "id": "stock",
          "label": "Built-in photo",
          "options": [
            { "value": "", "label": "None" },
            { "value": "jw-review-sarah.jpg", "label": "Sarah" },
            { "value": "jw-review-margaret.jpg", "label": "Margaret" },
            { "value": "jw-review-linda.jpg", "label": "Linda" },
            { "value": "jw-review-brenda.jpg", "label": "Brenda" },
            { "value": "jw-review-susan.jpg", "label": "Susan" }
          ],
          "default": ""
        },
        { "type": "url", "id": "link", "label": "Link to the review on Judge.me" }
      ]
    }
  ],
  "presets": [
    {
      "name": "JW4 Reviews wall"
    }
  ]
}
{% endschema %}
