{% comment %} Proof strip: verifiable items only. Heat-in-general quotes (text, with caveat), the CE certificate, the guarantee and warranty row. When real video or photo reviews exist, they lead and the quotes drop beneath. {% endcomment %}
<section class="jw-proof2 jw-band">
  <div class="jw-wrap">
    {%- if section.settings.video_url != blank -%}
      <figure class="jw-card jw-reviews__video">
        {%- assign vu = section.settings.video_url -%}
        {%- if vu contains 'youtube.com' or vu contains 'youtu.be' -%}
          {%- assign vid = vu | split: 'v=' | last | split: '&' | first | split: '/' | last -%}
          <iframe class="jw-reviews__frame" src="https://www.youtube-nocookie.com/embed/{{ vid }}" title="{{ section.settings.video_title | escape }}" loading="lazy" allowfullscreen></iframe>
        {%- else -%}
          <video class="jw-reviews__frame" controls preload="metadata" src="{{ vu }}"></video>
        {%- endif -%}
        <figcaption class="jw-body"><strong>{{ section.settings.video_title | escape }}</strong></figcaption>
      </figure>
    {%- endif -%}
    <ul class="jw-proof2__quotes" role="list">
      {%- for block in section.blocks -%}
        {%- if block.settings.quote == blank -%}{%- continue -%}{%- endif -%}
        <li {{ block.shopify_attributes }}><span class="jw-proof2__who">{{ block.settings.who | escape }}</span> <q>{{ block.settings.quote | escape }}</q>{% if block.settings.source_url != blank %} <a class="jw-proof2__src" href="{{ block.settings.source_url }}" target="_blank" rel="noopener">Source</a>{% endif %}</li>
      {%- endfor -%}
    </ul>
    <p class="jw-caption">{{ section.settings.caveat | escape }}</p>
    <ul class="jw-assure jw-proof2__row" role="list">
      <li><span class="jw-assure__icon" aria-hidden="true">CE</span><span><strong>Independently tested</strong><br><a href="{{ 'jw-ce-certificate.jpg' | asset_url }}" target="_blank" rel="noopener">Open the certificate</a></span></li>
      <li><span class="jw-assure__icon" aria-hidden="true">90</span><span><strong>90-day trial</strong><br>we pay return postage</span></li>
      <li><span class="jw-assure__icon" aria-hidden="true">2yr</span><span><strong>2-year warranty</strong><br>replacement, not repair</span></li>
      <li><span class="jw-assure__icon" aria-hidden="true">UK</span><span><strong>Free tracked delivery</strong><br>UK support by email</span></li>
    </ul>
  </div>
</section>
{% schema %}
{
  "name": "JW Proof strip",
  "tag": "section",
  "class": "jw-section-proof2",
  "settings": [
    { "type": "text", "id": "caveat", "label": "Caveat", "default": "Statements about heat in general. Jointwell is a comfort device, not a medical treatment." },
    { "type": "header", "content": "Video review (leads the strip when set)" },
    { "type": "text", "id": "video_url", "label": "Video link", "info": "A real customer, with permission. YouTube or MP4." },
    { "type": "text", "id": "video_title", "label": "Who is in it" }
  ],
  "blocks": [{ "type": "quote", "name": "Quote", "limit": 4, "settings": [
    { "type": "text", "id": "who", "label": "Who" },
    { "type": "textarea", "id": "quote", "label": "Quote, verbatim" },
    { "type": "url", "id": "source_url", "label": "Source link" }
  ] }],
  "presets": [{ "name": "JW Proof strip" }]
}
{% endschema %}
