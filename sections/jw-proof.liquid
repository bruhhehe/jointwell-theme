{% comment %}
  Trust row under the hero. Four things that can be checked, each specific and each a link where a link exists.
  "Independently tested" says by whom and to what: CE, EMC Directive 2014/30/EU, independent laboratory, 21 November 2024.
  Optional video review leads the row when set.
{% endcomment %}
<section class="jw-proof2 jw-band">
  <div class="jw-wrap">
    {%- if section.settings.video_url != blank -%}
      <figure class="jw-card jw-reviews__video">
        {%- assign vu = section.settings.video_url -%}
        {%- if vu contains 'youtube.com' or vu contains 'youtu.be' -%}
          {%- assign vid = vu | split: 'v=' | last | split: '&' | first | split: '/' | last -%}
          <iframe class="jw-reviews__frame" src="https://www.youtube-nocookie.com/embed/{{ vid }}" title="{{ section.settings.video_title | escape }}" loading="lazy" allowfullscreen></iframe>
        {%- else -%}
          <video class="jw-reviews__frame" controls preload="metadata" src="{{ vu }}"></video>
        {%- endif -%}
        <figcaption class="jw-body"><strong>{{ section.settings.video_title | escape }}</strong></figcaption>
      </figure>
    {%- endif -%}
    <ul class="jw-assure jw-proof2__row" role="list">
      <li><span class="jw-assure__icon" aria-hidden="true">CE</span><span><strong>{{ section.settings.ce_title | escape }}</strong><br>{{ section.settings.ce_text | escape }} <a href="{{ 'jw-ce-certificate.jpg' | asset_url }}" target="_blank" rel="noopener">{{ section.settings.ce_link | escape }}</a></span></li>
      <li><span class="jw-assure__icon" aria-hidden="true">90</span><span><strong>90-day trial</strong><br>we pay the return postage. <a href="#jw-guarantee">How it works</a></span></li>
      <li><span class="jw-assure__icon" aria-hidden="true">2yr</span><span><strong>2-year warranty</strong><br>replacement, not repair</span></li>
      <li><span class="jw-assure__icon" aria-hidden="true">UK</span><span><strong>UK returns address</strong><br>{{ section.settings.uk_text | escape }}</span></li>
    </ul>
    {%- if section.settings.caveat != blank -%}<p class="jw-caption">{{ section.settings.caveat | escape }}</p>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "JW Trust row",
  "tag": "section",
  "class": "jw-section-proof2",
  "settings": [
    { "type": "text", "id": "ce_title", "label": "Testing: bold line", "default": "Independently tested" },
    { "type": "text", "id": "ce_text", "label": "Testing: what, by whom", "default": "CE, EMC Directive 2014/30/EU, independent lab, 21 Nov 2024." },
    { "type": "text", "id": "ce_link", "label": "Testing: link text", "default": "Open the certificate" },
    { "type": "text", "id": "uk_text", "label": "UK line", "default": "support by email, a reply within one working day" },
    { "type": "text", "id": "caveat", "label": "Caveat", "default": "The CE test covers electrical safety and interference. It does not make this a medical device, and we do not claim it is one." },
    { "type": "header", "content": "Video review (leads the row when set)" },
    { "type": "text", "id": "video_url", "label": "Video link", "info": "A real customer, with permission. YouTube or MP4." },
    { "type": "text", "id": "video_title", "label": "Who is in it" }
  ],
  "presets": [{ "name": "JW Trust row" }]
}
{% endschema %}
