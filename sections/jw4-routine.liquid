{% comment %}
  The Morning Half Hour as a visual ladder. A routine, not a treatment. No outcome promises per stage.
{% endcomment %}
<section class="jw4 jw4--cream jw4-routine" id="jw-routine">
  <div class="jw-wrap">
    <div class="jw4__center">
      {%- if section.settings.eyebrow != blank -%}<p class="jw4__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="jw-h2">{{ section.settings.heading | escape }}</h2>
      <p class="jw-lead">{{ section.settings.intro | escape }}</p>
    </div>
    <ol class="jw4-routine__steps">
      {%- for block in section.blocks -%}
        <li class="jw4-routine__step" {{ block.shopify_attributes }}>
          <span class="jw4-routine__when">{{ block.settings.when | escape }}</span>
          <p>{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ol>
    {% render 'jw-cta-strip', link: section.settings.cta_link, label: section.settings.cta_label %}
  </div>
</section>

{% schema %}
{
  "name": "JW4 Routine ladder",
  "tag": "section",
  "class": "jw4-section-routine",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line",
      "default": "What to expect"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Morning Half Hour"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "One line under it",
      "default": "A routine, not a treatment. Kettle on, wrap on, and your joint gets the deciding vote."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button",
      "default": "Start the 90 days"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Stage",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "when",
          "label": "When",
          "default": "Day 1"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "The instruction",
          "default": "Level 1 or 2, massage off, thirty minutes with the first cup of tea."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JW4 Routine ladder",
      "blocks": [
        { "type": "step", "settings": { "when": "Day 1", "text": "Level 1 or 2 (45 to 50°C), massage off, thirty minutes with the first cup of tea." } },
        { "type": "step", "settings": { "when": "Day 3", "text": "Same chair, same time. Try the gentle massage. It switches itself off when the tea is finished." } },
        { "type": "step", "settings": { "when": "Week 2", "text": "Move up to level 3 if you want more. Seven mornings a week. Twice a week does nothing." } },
        { "type": "step", "settings": { "when": "Week 4", "text": "Your level, every morning. By now you will know whether it has earned its place by the kettle." } },
        { "type": "step", "settings": { "when": "Day 90", "text": "Keep it, or post it back and we pay the postage. The warranty runs for two years either way." } }
      ]
    }
  ]
}
{% endschema %}
