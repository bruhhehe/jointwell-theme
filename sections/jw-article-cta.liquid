{% comment %}
  Persistent closing block for Advice (doorway) articles. Every article ends on the buy button.
  Used by templates/article.jw-doorway.json.
{% endcomment %}
<section class="jw-guarantee jw-band jw-article-cta">
  <div class="jw-wrap jw-narrow">
    <div class="jw-card jw-guarantee__card">
      <p class="jw-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 class="jw-h2">{{ section.settings.heading | escape }}</h2>
      <p class="jw-lead">{{ section.settings.text | escape }}</p>
      {%- if section.settings.show_price -%}
        <p class="jw-body"><strong>{{ section.settings.price_line | escape }}</strong></p>
      {%- endif -%}
      {%- assign cta_link = section.settings.cta_link | default: '/#jw-buy' -%}
      {% render 'jw-cta-strip', link: cta_link, label: section.settings.cta_label %}
      {%- if section.settings.disclaimer != blank -%}
        <p class="jw-caption">{{ section.settings.disclaimer | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JW Article closing call",
  "tag": "section",
  "class": "jw-section-article-cta",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "The 90-day worst-joint trial" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Try it on the joint that runs your day" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Ninety mornings to decide. If it has not earned its place by the kettle, post it back and we pay the postage. Every wrap carries a 2-year warranty and UK support." },
    { "type": "checkbox", "id": "show_price", "label": "Show the price line", "default": true },
    { "type": "text", "id": "price_line", "label": "Price line", "default": "£49 for one wrap, £69 for two. Free tracked UK delivery." },
    { "type": "text", "id": "cta_label", "label": "Button text", "default": "Try it for 90 days" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Leave blank to go to the homepage buy box." },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "Jointwell is a heat and massage device for the comfort of stiff, tired joints. It is not a medical treatment and does not cure, treat or prevent any condition. If you have diabetes, circulation problems or reduced skin sensation, check with your GP before using any heat product." }
  ],
  "presets": [{ "name": "JW Article closing call" }]
}
{% endschema %}
