{% comment %} The 90-day worst-joint trial. {% endcomment %}
<section class="jw-guarantee jw-band" id="jw-guarantee">
  <div class="jw-wrap jw-narrow">
    <div class="jw-card jw-guarantee__card">
      <p class="jw-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 class="jw-h2">{{ section.settings.heading | escape }}</h2>
      <p class="jw-lead">{{ section.settings.lead | escape }}</p>
      <div class="jw-prose">{{ section.settings.body }}</div>
      <p class="jw-guarantee__worst">{{ section.settings.worst_case | escape }}</p>
      {% render 'jw-cta-strip', link: section.settings.cta_link, label: section.settings.cta_label %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JW Guarantee",
  "tag": "section",
  "class": "jw-section-guarantee",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "The 90-day worst-joint trial" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "If it doesn't help, we don't keep your money." },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "Use Jointwell every morning for up to three months, on your own knee or shoulder, in your own kitchen." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>If you can't feel the difference, send it back within 90 days of delivery for a full refund and <strong>we pay the return postage</strong>. Every wrap carries a 2-year warranty as well, with UK support.</p>" },
    { "type": "text", "id": "worst_case", "label": "Worst case line", "default": "Worst case, you post it back and you are where you started." },
    { "type": "text", "id": "cta_label", "label": "Button text", "default": "Start the 90 days" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "JW Guarantee" }]
}
{% endschema %}
