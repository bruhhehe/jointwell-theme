{% comment %}
  The Decline. A run of short beats, each with a photo (or a marked placeholder until the photo exists)
  and two or three lines. Block types: beat (photo + lines), text (words only, larger, centred),
  heading (a second heading and its line), handoff (one italic line).
{% endcomment %}
<section class="jw4 jw5-decline" id="jw-decline">
  <div class="jw-wrap">
    <div class="jw4__center">
      <h2 class="jw-h2">{{ section.settings.heading | escape }}</h2>
      <p class="jw-lead">{{ section.settings.intro | escape }}</p>
    </div>
    <div class="jw5-decline__beats">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'beat' -%}
            <div class="jw5-beat" {{ block.shopify_attributes }}>
              <div class="jw5-beat__media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 800, 1000', sizes: '(min-width: 900px) 45vw, 100vw', class: 'jw4__img jw5-beat__img', alt: block.settings.shot }}
                {%- else -%}
                  <div class="jw5-ph" role="img" aria-label="{{ block.settings.shot | escape }}"><span class="jw5-ph__icon" aria-hidden="true">&#128247;</span><span class="jw5-ph__text">{{ block.settings.shot | escape }}</span></div>
                {%- endif -%}
              </div>
              <div class="jw5-beat__lines">
                {%- assign lines = block.settings.lines | escape | newline_to_br | replace: '<br>', '<br />' | split: '<br />' -%}
                {%- for l in lines -%}{%- assign t = l | strip -%}{%- if t != blank -%}<p>{{ t }}</p>{%- endif -%}{%- endfor -%}
              </div>
            </div>
          {%- when 'text' -%}
            <div class="jw5-text" {{ block.shopify_attributes }}>
              {%- assign lines = block.settings.lines | escape | newline_to_br | replace: '<br>', '<br />' | split: '<br />' -%}
              {%- for l in lines -%}{%- assign t = l | strip -%}{%- if t != blank -%}<p>{{ t }}</p>{%- endif -%}{%- endfor -%}
            </div>
          {%- when 'heading' -%}
            <div class="jw5-subhead jw4__center" {{ block.shopify_attributes }}>
              <h2 class="jw-h2">{{ block.settings.heading | escape }}</h2>
              {%- if block.settings.intro != blank -%}<p class="jw-lead">{{ block.settings.intro | escape }}</p>{%- endif -%}
            </div>
          {%- when 'handoff' -%}
            <p class="jw5-handoff" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JW5 The decline",
  "tag": "section",
  "class": "jw5-section-decline",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "It starts with the stairs. It never stays there." },
    { "type": "textarea", "id": "intro", "label": "Line under the heading", "default": "If any of this sounds familiar, keep reading." }
  ],
  "blocks": [
    {
      "type": "beat",
      "name": "Photo and lines",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "shot", "label": "The shot (shows as a placeholder until the photo is set)", "default": "Stairs, shot from the bottom looking up." },
        { "type": "textarea", "id": "lines", "label": "Lines, one per line", "default": "Sideways?\nOne step at a time?" }
      ]
    },
    {
      "type": "text",
      "name": "Words only",
      "settings": [
        { "type": "textarea", "id": "lines", "label": "Lines, one per line", "default": "Everyone your age has a knee.\nSo you don't mention it." }
      ]
    },
    {
      "type": "heading",
      "name": "Second heading",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Then you go to the GP." },
        { "type": "text", "id": "intro", "label": "Line under it", "default": "Everyone does their best. It still is not enough." }
      ]
    },
    {
      "type": "handoff",
      "name": "Hand-off line",
      "settings": [
        { "type": "text", "id": "text", "label": "One italic line", "default": "That's the bit Paula got tired of waiting for." }
      ]
    }
  ],
  "presets": [ { "name": "JW5 The decline" } ]
}
{% endschema %}
