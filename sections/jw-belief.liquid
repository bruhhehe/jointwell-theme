            "stock": "jw-feature-massage.jpg"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Strapped on, cordless, off by itself at 30 minutes",
            "text": "It stays where you put it while you walk to the kettle. No wire. It switches itself off, so it cannot be left running and the half hour becomes a habit.",
