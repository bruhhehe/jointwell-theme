{% comment %}
  v4 hero. One photo, one headline that does the selling, three ticks, the price, one button.
  No tier picker here: the button jumps to the offer block, which asks the only question (how many).
{% endcomment %}
{%- liquid
  assign product = section.settings.product
  if product == blank
    assign product = all_products[section.settings.product_handle]
  endif
  assign price_text = section.settings.price_text
  assign compare_text = section.settings.compare_text
  if product != blank
    assign price_text = product.price | money_without_trailing_zeros
    if product.compare_at_price > product.price
      assign compare_text = product.compare_at_price | money_without_trailing_zeros
    else
      assign compare_text = ''
    endif
  endif
  assign cta = section.settings.cta_link | default: '#offer'
-%}
<section class="jw4 jw4-hero" id="jw-hero">
  <div class="jw-wrap jw4-hero__grid">
    <div class="jw4-hero__media">
      {%- if section.settings.ba_image != blank -%}
        {{ section.settings.ba_image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1400', sizes: '(min-width: 900px) 50vw, 100vw', class: 'jw4__img jw4-hero__img', alt: section.settings.ba_caption }}
      {%- elsif section.settings.ba_stock != blank -%}
        {%- comment -%} Built-in photo, so the hero shows a real picture without an
        upload in the editor. An image_picker upload still wins if one is set. {%- endcomment -%}
        <img class="jw4__img jw4-hero__img" src="{{ section.settings.ba_stock | asset_url }}"
             width="1200" height="1262" loading="eager" fetchpriority="high"
             alt="{{ section.settings.ba_caption | escape }}">
      {%- else -%}
        <div class="jw5-ph jw5-ph--hero" role="img" aria-label="{{ section.settings.ba_caption | escape }}"><span class="jw5-ph__icon" aria-hidden="true">&#128247;</span><span class="jw5-ph__text">{{ section.settings.ba_caption | escape }}</span></div>
      {%- endif -%}
      {%- if section.settings.inset_stock != blank or section.settings.inset_image != blank -%}
        <div class="jw4-hero__inset">
          {%- if section.settings.inset_image != blank -%}
            {{ section.settings.inset_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: 'The Jointwell wrap' }}
          {%- else -%}
            <img src="{{ section.settings.inset_stock | asset_url }}" width="500" height="500" loading="lazy" alt="The Jointwell wrap">
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
    <div class="jw4-hero__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="jw4__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="jw-h1">{{ section.settings.heading | escape }}</h1>
      <p class="jw-lead">{{ section.settings.subline | escape }}</p>
      {%- if section.settings.subline_2 != blank -%}<p class="jw4-hero__second">{{ section.settings.subline_2 | escape }}</p>{%- endif -%}
      <div class="jw4-hero__cta">
        {%- if section.settings.rating_line != blank -%}
          <p class="jw4-hero__rating"><span class="jw-stars" aria-hidden="true">{{ section.settings.rating_stars | default: '★★★★★' }}</span> {{ section.settings.rating_line | escape }}</p>
        {%- endif -%}
        <a class="jw-btn jw-btn--primary" href="{{ cta }}">{{ section.settings.cta_label | escape }}{%- if section.settings.cta_show_price and price_text != blank %} <span class="jw4-hero__btnprice">&mdash; from {{ price_text }}</span>{% endif -%}</a>
        <p class="jw4-hero__proof">{{ section.settings.proof_line | escape }}</p>
        {%- if section.settings.scroll_label != blank -%}
          <a class="jw4-hero__scroll" href="{{ section.settings.scroll_link | default: '#jw-discovery' }}">{{ section.settings.scroll_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
<script>
  (function () {
    var d = document.querySelector('[data-jw-dispatch]');
    if (!d) return;
    var hour = parseInt(d.getAttribute('data-hour'), 10) || 14;
    var days = (d.getAttribute('data-days') || '1,2,3,4,5').split(',').map(function (x) { return parseInt(x, 10); });
    var out = d.querySelector('[data-jw-dispatch-text]');
    var names = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
    function tick() {
      var parts = {}, wd = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
      new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', weekday: 'short', hour: 'numeric', minute: 'numeric', hourCycle: 'h23' }).formatToParts(new Date()).forEach(function (x) { parts[x.type] = x.value; });
      var dow = wd[parts.weekday], h = parseInt(parts.hour, 10) % 24, m = parseInt(parts.minute, 10);
      if (days.indexOf(dow) > -1 && h < hour) {
        var left = (hour - h) * 60 - m, hh = Math.floor(left / 60), mm = left % 60;
        out.textContent = 'Order in the next ' + (hh ? hh + ' hr ' : '') + mm + ' min and it leaves us today.';
      } else {
        var n = dow, add = 0;
        do { n = (n + 1) % 7; add++; } while (days.indexOf(n) < 0 && add < 8);
        out.textContent = 'Order now and it leaves us ' + (add === 1 ? 'tomorrow' : 'on ' + names[n]) + '.';
      }
      d.hidden = false;
    }
    tick(); setInterval(tick, 60000);
  })();
</script>

