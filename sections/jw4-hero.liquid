{% comment %}
  v4 hero. One photo, one headline that does the selling, three ticks, the price, one button.
  No tier picker here: the button jumps to the offer block, which asks the only question (how many).
{% endcomment %}
{%- liquid
  assign product = section.settings.product
  if product == blank
    assign product = all_products[section.settings.product_handle]
  endif
  assign price_text = section.settings.price_text
  assign compare_text = section.settings.compare_text
  if product != blank
    assign price_text = product.price | money_without_trailing_zeros
    if product.compare_at_price > product.price
      assign compare_text = product.compare_at_price | money_without_trailing_zeros
    else
      assign compare_text = ''
    endif
  endif
  assign cta = section.settings.cta_link | default: '#jw-offer'
-%}
<section class="jw4 jw4-hero" id="jw-hero">
  <div class="jw-wrap jw4-hero__grid">
    <div class="jw4-hero__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1400', sizes: '(min-width: 900px) 50vw, 100vw', class: 'jw4__img jw4-hero__img', alt: section.settings.image_alt }}
      {%- else -%}
        <img class="jw4__img jw4-hero__img" src="{{ section.settings.stock | asset_url }}" width="1024" height="1152" alt="{{ section.settings.image_alt | escape }}" fetchpriority="high">
      {%- endif -%}
      {%- if section.settings.review_quote != blank -%}
        <div class="jw4-hero__badge">
          {%- if section.settings.review_stock != blank -%}<img src="{{ section.settings.review_stock | asset_url }}" width="88" height="88" alt="" loading="lazy">{%- endif -%}
          <div>{{ section.settings.review_name | escape }} <span class="jw-stars" aria-label="Five stars" style="color:var(--jw-star)">★★★★★</span><span>{{ section.settings.review_quote | escape }}</span></div>
        </div>
      {%- endif -%}
    </div>
    <div class="jw4-hero__copy">
      <p class="jw4__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 class="jw-h1">{{ section.settings.heading | escape }}</h1>
      <p class="jw-lead">{{ section.settings.subline | escape }}</p>
      <ul class="jw4-hero__ticks" role="list">
        <li>{{ section.settings.tick_1 | escape }}</li>
        <li>{{ section.settings.tick_2 | escape }}</li>
        <li>{{ section.settings.tick_3 | escape }}</li>
      </ul>
      <div class="jw4-hero__price">
        <span class="jw4-hero__now">{{ price_text }}</span>
        {%- if compare_text != blank -%}<s class="jw4-hero__was">{{ compare_text }}</s>{%- endif -%}
      </div>
      <p class="jw4-hero__pricenote">{{ section.settings.price_note | escape }}</p>
      <div class="jw4-hero__cta">
        <a class="jw-btn jw-btn--primary" href="{{ cta }}">{{ section.settings.cta_label | escape }}</a>
        <ul class="jw-trust" role="list">
          <li>90-day trial, we pay return postage</li>
          <li>2-year UK warranty</li>
          <li>Free tracked delivery</li>
        </ul>
      </div>
      {%- if section.settings.dispatch_hour > 0 -%}
        <p class="jw4-hero__dispatch" data-jw-dispatch data-hour="{{ section.settings.dispatch_hour }}" data-days="{{ section.settings.dispatch_days }}" hidden><span data-jw-dispatch-text></span></p>
      {%- endif -%}
      <p class="jw4-hero__stars"><span class="jw-stars" aria-hidden="true">★★★★★</span> <a href="#jw-reviews">{{ section.settings.reviews_text | escape }}</a></p>
      <p class="jw4-hero__disc">{{ section.settings.disclaimer | escape }}</p>
    </div>
  </div>
</section>
<script>
  (function () {
    var d = document.querySelector('[data-jw-dispatch]');
    if (!d) return;
    var hour = parseInt(d.getAttribute('data-hour'), 10) || 14;
    var days = (d.getAttribute('data-days') || '1,2,3,4,5').split(',').map(function (x) { return parseInt(x, 10); });
    var out = d.querySelector('[data-jw-dispatch-text]');
    var names = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
    function tick() {
      var parts = {}, wd = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
      new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', weekday: 'short', hour: 'numeric', minute: 'numeric', hourCycle: 'h23' }).formatToParts(new Date()).forEach(function (x) { parts[x.type] = x.value; });
      var dow = wd[parts.weekday], h = parseInt(parts.hour, 10) % 24, m = parseInt(parts.minute, 10);
      if (days.indexOf(dow) > -1 && h < hour) {
        var left = (hour - h) * 60 - m, hh = Math.floor(left / 60), mm = left % 60;
        out.textContent = 'Order in the next ' + (hh ? hh + ' hr ' : '') + mm + ' min and it leaves us today.';
      } else {
        var n = dow, add = 0;
        do { n = (n + 1) % 7; add++; } while (days.indexOf(n) < 0 && add < 8);
        out.textContent = 'Order now and it leaves us ' + (add === 1 ? 'tomorrow' : 'on ' + names[n]) + '.';
      }
      d.hidden = false;
    }
    tick(); setInterval(tick, 60000);
  })();
</script>

{% schema %}
{
  "name": "JW4 Hero",
  "tag": "section",
  "class": "jw4-section-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above the headline",
      "default": "For knees, shoulders and elbows that have got worse"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Stop planning your day around one knee."
    },
    {
      "type": "textarea",
      "id": "subline",
      "label": "One line under it",
      "default": "Half an hour of warmth that stays put, every morning, with gentle massage. Cordless, strapped on, and it switches itself off."
    },
    {
      "type": "text",
      "id": "tick_1",
      "label": "Tick 1",
      "default": "Heat held for 30 minutes, 45 to 65°C"
    },
    {
      "type": "text",
      "id": "tick_2",
      "label": "Tick 2",
      "default": "Three massage strengths"
    },
    {
      "type": "text",
      "id": "tick_3",
      "label": "Tick 3",
      "default": "Cordless. Strapped on. Off by itself."
    },
    {
      "type": "header",
      "content": "Price and button"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "product_handle",
      "label": "Product handle (fallback)",
      "default": "jointwell-heated-joint-wrap"
    },
    {
      "type": "text",
      "id": "price_text",
      "label": "Price if no product",
      "default": "£49"
    },
    {
      "type": "text",
      "id": "compare_text",
      "label": "Was price if no product",
      "default": "£65"
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "Line under the price",
      "default": "Autumn price until 30 September. One payment, free tracked UK delivery."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button",
      "default": "Try it for 90 days"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link (blank jumps to the offer)"
    },
    {
      "type": "range",
      "id": "dispatch_hour",
      "label": "Same-day dispatch cut-off, UK time (0 hides)",
      "min": 0,
      "max": 18,
      "step": 1,
      "default": 14
    },
    {
      "type": "text",
      "id": "dispatch_days",
      "label": "Dispatch days (0=Sun ... 6=Sat)",
      "default": "1,2,3,4,5"
    },
    {
      "type": "text",
      "id": "reviews_text",
      "label": "Review line",
      "default": "Read what real buyers say"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Small print",
      "default": "A comfort device, not a medical treatment. If you have diabetes, circulation problems or reduced skin sensation, check with your GP before using heat."
    },
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo (4:5)"
    },
    {
      "type": "select",
      "id": "stock",
      "label": "Built-in photo",
      "options": [
        { "value": "jw-photo-garden-window.jpg", "label": "Garden window, smiling" },
        { "value": "jw-photo-armchair.jpg", "label": "Armchair with a book" },
        { "value": "jw-photo-kettle.jpg", "label": "At the kettle" },
        { "value": "jw-photo-breakfast.jpg", "label": "Breakfast table" },
        { "value": "jw-hero.jpg", "label": "Kitchen, red jumper" }
      ],
      "default": "jw-photo-garden-window.jpg"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photo description",
      "default": "Woman by her garden window with the Jointwell wrap on her knee"
    },
    {
      "type": "header",
      "content": "Review badge on the photo"
    },
    {
      "type": "text",
      "id": "review_name",
      "label": "Name",
      "default": "Sarah, 64"
    },
    {
      "type": "text",
      "id": "review_quote",
      "label": "One line from their review",
      "default": "I set it to 45 and it stays at 45."
    },
    {
      "type": "select",
      "id": "review_stock",
      "label": "Their photo",
      "options": [
        { "value": "", "label": "None" },
        { "value": "jw-review-sarah.jpg", "label": "Sarah" },
        { "value": "jw-review-margaret.jpg", "label": "Margaret" },
        { "value": "jw-review-linda.jpg", "label": "Linda" },
        { "value": "jw-review-brenda.jpg", "label": "Brenda" },
        { "value": "jw-review-susan.jpg", "label": "Susan" }
      ],
      "default": "jw-review-sarah.jpg"
    }
  ],
  "presets": [
    {
      "name": "JW4 Hero"
    }
  ]
}
{% endschema %}
