{% comment %} Final CTA. The best line on the page, at the end of the page. {% endcomment %}
<section class="jw-final jw-band">
  <div class="jw-wrap jw-final__grid">
    <div class="jw-final__copy">
      <h2 class="jw-h2">{{ section.settings.heading | escape }}</h2>
      <p class="jw-lead">{{ section.settings.text | escape }}</p>
      {% render 'jw-cta-strip', link: section.settings.cta_link, label: section.settings.cta_label %}
    </div>
    <div class="jw-final__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'jw-final__img', alt: section.settings.image_alt }}
      {%- else -%}
        <img class="jw-final__img" src="{{ 'jw-photo-floor.jpg' | asset_url }}" width="928" height="1152" loading="lazy" alt="{{ section.settings.image_alt | escape }}">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JW Final call",
  "tag": "section",
  "class": "jw-section-final",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get down on the floor with the grandchildren. And get back up again." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Half an hour a morning, so the day stops being planned around one joint. Try it for 90 days. If your knee is not convinced, we pay the postage back." },
    { "type": "text", "id": "cta_label", "label": "Button text", "default": "Try it for 90 days" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Photo (4:5)" },
    { "type": "text", "id": "image_alt", "label": "Photo description for screen readers", "default": "Grandmother on the carpet doing a jigsaw with the wrap on her knee" }
  ],
  "presets": [{ "name": "JW Final call" }]
}
{% endschema %}
