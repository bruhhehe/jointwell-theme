{% comment %}
  Borrowed authority. NHS first, then two surgeons, done.
  These are quotes about heat and massage in general, not claims about this device.
  Do not add words like "clinically proven" here or anywhere else.
{% endcomment %}
<section class="jw-authority{% if section.settings.strip %} jw-authority--strip{% endif %}">
  <div class="jw-wrap">
    <h2 class="jw-h2">{{ section.settings.heading | escape }}</h2>
    <p class="jw-lead jw-narrow">{{ section.settings.intro | escape }}</p>
    <div class="jw-quotes jw-authority__quotes">
      {%- for block in section.blocks -%}
        {%- if block.settings.quote == blank -%}{%- continue -%}{%- endif -%}
        <figure class="jw-card jw-quote" {{ block.shopify_attributes }}>
          {%- if block.settings.logo != blank -%}
            {{ block.settings.logo | image_url: width: 240 | image_tag: loading: 'lazy', class: 'jw-quote__logo', alt: block.settings.who }}
          {%- else -%}
            <span class="jw-authority__source">{{ block.settings.who | escape }}</span>
          {%- endif -%}
          <blockquote>{{ block.settings.quote | escape }}</blockquote>
          <figcaption>
            <span class="jw-quote__who">{{ block.settings.role | escape }}</span>
            {%- if block.settings.source_url != blank -%}
              <a class="jw-quote__src" href="{{ block.settings.source_url }}" rel="noopener" target="_blank">Source</a>
            {%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
    <p class="jw-caption jw-narrow">{{ section.settings.footnote | escape }}</p>
    {% render 'jw-cta-strip', link: section.settings.cta_link, label: section.settings.cta_label, style: 'none' %}
  </div>
</section>

{% schema %}
{
  "name": "JW Borrowed authority",
  "tag": "section",
  "class": "jw-section-authority",
  "settings": [
    { "type": "checkbox", "id": "strip", "label": "Show as a compact text strip", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heat and massage are what the NHS and orthopaedic surgeons recommend for stiff joints" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Jointwell puts both in one wrap you strap on at the kitchen table. Here is what the people who are not selling anything say about heat and massage." },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "default": "These are statements about heat and massage in general. Jointwell is a comfort device. It is not a medical treatment and does not cure, treat or prevent any condition." },
    { "type": "text", "id": "cta_label", "label": "Button text", "default": "Try it for 90 days" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "limit": 5,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo (only if you hold permission to use it)" },
        { "type": "text", "id": "role", "label": "Line under the quote (role or publication)" },
        { "type": "textarea", "id": "quote", "label": "Quote (verbatim from the source)" },
        { "type": "text", "id": "who", "label": "Who said it" },
        { "type": "url", "id": "source_url", "label": "Link to the source" }
      ]
    }
  ],
  "presets": [
    {
      "name": "JW Borrowed authority",
      "blocks": [
        { "type": "quote", "settings": { "quote": "Heat applied to the affected area can be very effective in reducing pain.", "who": "NHS" } },
        { "type": "quote", "settings": { "quote": "Heat therapy is an easy, inexpensive, and medication-free way to relieve some types of arthritis stiffness and pain.", "who": "Brandon Kambach, MD, orthopaedic surgeon" } },
        { "type": "quote", "settings": { "quote": "Using heat on sore or stiff joints can bring significant relief, especially when dealing with chronic arthritis pain.", "who": "Hayden N. Box, MD, orthopaedic surgeon" } }
      ]
    }
  ]
}
{% endschema %}
