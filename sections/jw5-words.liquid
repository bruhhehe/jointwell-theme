{% comment %} A heading, a line under it, and a few short lines of words. Used for "Why not you?". {% endcomment %}
<section class="jw4 jw4--cream jw5-words" id="{{ section.settings.anchor | default: 'jw-why-not-you' }}">
  <div class="jw-wrap jw4__center">
    <h2 class="jw-h2">{{ section.settings.heading | escape }}</h2>
    <p class="jw-lead">{{ section.settings.intro | escape }}</p>
    <div class="jw5-words__body">
      {%- assign lines = section.settings.lines | escape | newline_to_br | replace: '<br>', '<br />' | split: '<br />' -%}
      {%- for l in lines -%}{%- assign t = l | strip -%}{%- if t != blank -%}<p>{{ t }}</p>{%- endif -%}{%- endfor -%}
    </div>
    {% render 'jw-cta-strip', link: section.settings.cta_link, label: section.settings.cta_label %}
  </div>
</section>

{% schema %}
{
  "name": "JW5 Words",
  "tag": "section",
  "class": "jw5-section-words",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why not you?" },
    { "type": "textarea", "id": "intro", "label": "Line under the heading", "default": "Paula didn't do anything clever." },
    { "type": "textarea", "id": "lines", "label": "Lines, one per line", "default": "Fifteen minutes with it on, whenever it suited her, and she got on with her day.\nIf you recognised the stairs, the chair, the garden through the window, you're where she was at the start.\nThe device is the same one she's still using." },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "jw-why-not-you" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Try it for 90 days" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [ { "name": "JW5 Words" } ]
}
{% endschema %}
